# =============================================================================
# TubeToCD client — copy to .env
# =============================================================================

# Site (SEO / canonicals)
# Dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3024
# Prod:
# NEXT_PUBLIC_SITE_URL=https://tubetocd.com

# API
# Dev (server listens on 3025):
NEXT_PUBLIC_API_URL=http://localhost:3025
# Prod:
# NEXT_PUBLIC_API_URL=https://api.tubetocd.com

# --- Stripe (only if you use pricing/subscriptions) ---
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# NEXT_PUBLIC_STRIPE_PRICE_BASIC=
# NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=
# NEXT_PUBLIC_STRIPE_PRICE_ULTIMATE=
