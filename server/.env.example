# TubeToCD API — copy to .env and fill in
DATABASE_PATH=./data/database.sqlite
PORT=3025
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Extra CORS origins (comma-separated). Defaults already include:
# https://tubetocd.com, https://www.tubetocd.com, http://localhost:3024
# CORS_ORIGINS=https://staging.tubetocd.com

# Optional yt-dlp
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
# YT_DLP_COOKIES_FROM_BROWSER=chrome
# YT_DLP_COOKIES=/absolute/path/to/cookies.txt

# OPENAI_API_KEY=
