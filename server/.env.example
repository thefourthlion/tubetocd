# TubeToCD API — copy to .env and fill in
# Never commit real secrets.

NODE_ENV=development
PORT=3025
DATABASE_PATH=./data/database.sqlite

# REQUIRED in production — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Extra CORS origins (comma-separated). Defaults already include:
# https://tubetocd.com, https://www.tubetocd.com, http://localhost:3024
# CORS_ORIGINS=https://staging.tubetocd.com

# Optional yt-dlp
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
# YT_DLP_COOKIES_FROM_BROWSER=chrome
# YT_DLP_COOKIES=/absolute/path/to/cookies.txt
# YT_DLP_EXTRACTOR_ARGS=youtube:player_client=android,web,tv_embedded

# Listen-stream cache TTL (ms). Default ~48h.
# LISTEN_CACHE_TTL_MS=172800000

# Optional — enables POST /api/ai/name-tracks
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
